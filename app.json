{
  "expo": {
    "name": "RAFH-Mobile",
    "slug": "RAFH-Mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon_rafh.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon_rafh.png",
      "resizeMode": "contain",
      "backgroundColor": "#25A4D6"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": { // <-- AÑADIDO (Todo este bloque)
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "192.168.100.77": { // <-- ¡¡RECUERDA CAMBIAR ESTO!!
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_rafh.png",
        "backgroundColor": "#25A4D6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.robert0_vazquez.RAFHMobile",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/icon_rafh.png"
    },
